if [[ "$OS_ID" != "debian" ]]; then
    echo "[ERROR] This script requires Debian 10/11/12/13. Detected: $OS_ID $OS_VER"
    exit 1
fi
if [[ "$OS_VER" != "10" && "$OS_VER" != "11" && "$OS_VER" != "12" && "$OS_VER" != "13" ]]; then
    echo "[ERROR] Unsupported Debian version: $OS_VER. Supported: 10, 11, 12, 13"
    exit 1
fi
echo "[INFO] OS check passed: Debian $OS_VER"

