#====================================================
#   Install Sudo & User
#====================================================
install_sudo(){
# Create user if not exists
if ! id "adminmtk" &>/dev/null; then
useradd -m -s /bin/bash adminmtk
echo "adminmtk:Mediatek272124@@" | chpasswd
usermod -aG sudo adminmtk
fi

# --- SSH Configuration ---
# Disable root SSH login
sed -i 's/^PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config
grep -q "^PermitRootLogin" /etc/ssh/sshd_config || echo "PermitRootLogin no" >> /etc/ssh/sshd_config

# Enable both password and key-based authentication
sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config
grep -q "^PasswordAuthentication" /etc/ssh/sshd_config || echo "PasswordAuthentication yes" >> /etc/ssh/sshd_config

sed -i 's/^#\?PubkeyAuthentication.*/PubkeyAuthentication yes/' /etc/ssh/sshd_config
grep -q "^PubkeyAuthentication" /etc/ssh/sshd_config || echo "PubkeyAuthentication yes" >> /etc/ssh/sshd_config

sed -i 's/^#\?AuthorizedKeysFile.*/AuthorizedKeysFile .ssh\/authorized_keys/' /etc/ssh/sshd_config
grep -q "^AuthorizedKeysFile" /etc/ssh/sshd_config || echo "AuthorizedKeysFile .ssh/authorized_keys" >> /etc/ssh/sshd_config

# Ensure AllowGroups is set only once
if ! grep -q "^AllowGroups adminmtk" /etc/ssh/sshd_config; then
echo "AllowGroups adminmtk" >> /etc/ssh/sshd_config
fi

# Prepare authorized_keys file for adminmtk
mkdir -p /home/adminmtk/.ssh
chmod 700 /home/adminmtk/.ssh
touch /home/adminmtk/.ssh/authorized_keys
chmod 600 /home/adminmtk/.ssh/authorized_keys
chown -R adminmtk:adminmtk /home/adminmtk/.ssh

# Restart SSH service
systemctl restart ssh || systemctl restart sshd
}

#====================================================
#   Install Requirements
#====================================================
install_require() {
clear
echo "[INFO] Installing dependencies..."
{
# Stop firewalls (avoid blocking during setup)
systemctl stop firewalld 2>/dev/null || true
systemctl disable firewalld 2>/dev/null || true
systemctl stop nftables 2>/dev/null || true
systemctl disable nftables 2>/dev/null || true
systemctl stop ufw 2>/dev/null || true
systemctl disable ufw 2>/dev/null || true

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export DEBIAN_FRONTEND=noninteractive

# Update system
apt update -y

# Essential packages
apt install -y lsof tar systemd dbus git
apt install -y gnupg2 ca-certificates lsb-release debian-archive-keyring socat
apt install -y curl wget cron python3-minimal libpython3-stdlib
apt install -y iptables sudo
apt install -y openvpn netcat-openbsd httpie php neofetch vnstat
apt install -y screen squid stunnel4 dropbear gnutls-bin build-essential
apt install -y dos2unix nano unzip jq virt-what net-tools default-mysql-client
apt install -y mlocate dh-make libaudit-dev fail2ban

# Setup cron
touch /var/spool/cron/crontabs/root
chmod 600 /var/spool/cron/crontabs/root
systemctl enable --now cron

# Prevent missing bin dirs
mkdir -p /usr/local/bin /usr/local/var/run /root/.web
chmod 777 /root/.web

# --- Configure OpenSSH ---
echo "[INFO] Configuring OpenSSH..."

systemctl stop ssh.socket >/dev/null 2>&1 || true
systemctl disable ssh.socket >/dev/null 2>&1 || true
systemctl enable ssh.service

sed -i '/^#\?AddressFamily/d' /etc/ssh/sshd_config
echo "AddressFamily any" >> /etc/ssh/sshd_config

sed -i '/^#\?ListenAddress/d' /etc/ssh/sshd_config
echo "ListenAddress 0.0.0.0" >> /etc/ssh/sshd_config
echo "ListenAddress ::" >> /etc/ssh/sshd_config

# Ensure SSH auto-restarts
mkdir -p /etc/systemd/system/ssh.service.d
cat > /etc/systemd/system/ssh.service.d/override.conf <<EOF
[Service]
Restart=always
RestartSec=5
StartLimitIntervalSec=0
EOF

# --- Configure Dropbear (port 442) ---
echo "[INFO] Configuring Dropbear..."

 cat > /etc/default/dropbear <<EOF
NO_START=0
DROPBEAR_PORT=442
DROPBEAR_EXTRA_ARGS=
DROPBEAR_BANNER="/etc/banner"
DROPBEAR_RECEIVE_WINDOW=65536
EOF

mkdir -p /etc/systemd/system/dropbear.service.d
cat > /etc/systemd/system/dropbear.service.d/override.conf <<EOF
[Service]
Restart=always
RestartSec=5
StartLimitIntervalSec=0
EOF

# Download banner
wget -q -O /etc/banner "https://raw.githubusercontent.com/A-l-amin/dxdevrpo/refs/heads/server_script/SshBanner"
chmod 644 /etc/banner

# Reload systemd and restart services
systemctl daemon-reexec
systemctl daemon-reload
systemctl enable ssh dropbear
systemctl restart ssh dropbear
} &>/dev/null
echo "[INFO] Dependencies, OpenSSH (22), and Dropbear (442) setup completed."
}

